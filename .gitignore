# Project data — everything under data/ is generated, EXCEPT the *-latest
# files, which are the ones the deployed frontend fetches at runtime and
# the scheduled workflow (.github/workflows/update-tle-data.yml) commits.
data/raw/*
!data/raw/tle-latest.json
data/processed/*
!data/processed/conjunctions-latest.json
