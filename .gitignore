# Project data — everything under data/ is generated. tle-latest.json is
# committed on the dedicated tle-data branch (see
# .github/workflows/update-tle-data.yml), never on main, so it's fully
# ignored here. conjunctions-latest.json is still tracked on main.
data/raw/*
data/processed/*
!data/processed/conjunctions-latest.json
