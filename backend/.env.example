# Copy to .env for local dev. Never commit the real .env file — it's already
# in .gitignore. On Render, set these as environment variables in the
# dashboard instead of uploading a .env file.

PORT=3000

# Supabase project -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Any random string — must match what you pass to scripts/setWebhook.js
TELEGRAM_WEBHOOK_SECRET=change-me

# Any random string — must also be set as a GitHub Actions secret
# (used by .github/workflows/update-tle-data.yml to call POST /api/refresh)
REFRESH_SECRET=change-me
